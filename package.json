{
  "name": "zerowork",
  "productName": "ZeroWork",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "办公 AI Agent 桌面端（基于 pi agent harness）",
  "author": {
    "name": "liang-zhenxiang",
    "email": "116311683@qq.com",
    "url": "https://github.com/liang-zhenxiang"
  },
  "contributors": [
    {
      "name": "liang-zhenxiang",
      "email": "116311683@qq.com",
      "url": "https://github.com/liang-zhenxiang"
    },
    {
      "name": "nicholyx",
      "email": "nicholyx@163.com",
      "url": "https://github.com/nicholyx"
    }
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/liang-zhenxiang/zerowork",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liang-zhenxiang/zerowork.git"
  },
  "bugs": {
    "url": "https://github.com/liang-zhenxiang/zerowork/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:icons": "node tools/build-icons.mjs",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"*.mjs\" \"tools/**/*.mjs\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"*.mjs\" \"tools/**/*.mjs\" \".github/**/*.yml\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:gui && npm run test:gui:model && npm run test:gui:loop && npm run test:gui:real && npm run test:gui:doc && npm run test:gui:docx && npm run test:gui:skill && npm run test:gui:cmd && npm run test:gui:auto && npm run test:gui:branch && npm run test:gui:palette",
    "test:gui": "npm run test:gui:smoke && npm run test:gui:sections && npm run test:gui:onboarding && npm run test:gui:settings && npm run test:gui:theme && npm run test:gui:recent && npm run test:gui:focus && npm run test:gui:space-pin && npm run test:gui:formula && npm run test:gui:updates && npm run test:gui:ipc && npm run test:gui:bridge && npm run test:gui:state && npm run test:gui:dialog && npm run test:gui:widget && npm run test:gui:artifact && npm run test:gui:subagent && npm run test:gui:team && npm run test:gui:preview && npm run test:gui:palette && npm run test:gui:modal-backdrop && npm run test:gui:dark-polish && npm run test:gui:library && npm run test:gui:pin && npm run test:gui:export-markdown",
    "test:gui:smoke": "node tests/e2e/gui-smoke.mjs",
    "test:gui:sections": "node tests/e2e/gui-sections.mjs",
    "test:gui:onboarding": "node tests/e2e/onboarding.mjs",
    "test:gui:ipc": "node tests/e2e/ipc-functional.mjs",
    "test:gui:state": "node tests/e2e/local-state.mjs",
    "test:gui:dialog": "node tests/e2e/dialog-native.mjs",
    "test:gui:model": "node tests/e2e/model-roundtrip.mjs",
    "test:gui:loop": "node tests/e2e/tool-loop.mjs",
    "test:gui:real": "node tests/e2e/real-model.mjs",
    "test:gui:doc": "node tests/e2e/doc-parsing.mjs",
    "test:gui:docx": "node tests/e2e/docx-runtime.mjs",
    "test:gui:skill": "node tests/e2e/skill-mcp.mjs",
    "test:all": "npm run lint:all && npm run test && npm run test:gui",
    "lint:all": "node scripts/lint.mjs",
    "check:daemon-graph": "node tools/check-daemon-graph.mjs",
    "check:app-id": "node scripts/check-app-id.mjs",
    "check:commit-msg": "node scripts/check-commit-msg.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:design-exceptions": "node scripts/check-design-exceptions.mjs",
    "check:theme-tokens": "node scripts/check-theme-tokens.mjs",
    "check:vendored-deps": "node scripts/check-vendored-deps.mjs",
    "check:resources": "node scripts/check-resources.mjs",
    "check:line-endings": "node scripts/check-line-endings.mjs",
    "check:renderer-assets": "node scripts/check-renderer-assets.mjs",
    "check:release-notes": "node scripts/check-release-notes.mjs",
    "check:package-size": "node scripts/check-package-size.mjs",
    "check:release-version": "node scripts/check-release-version.mjs",
    "test:gui:bridge": "node tests/e2e/bridge-rest.mjs",
    "test:gui:cmd": "node tests/e2e/command-exec.mjs",
    "test:gui:auto": "node tests/e2e/automation-run.mjs",
    "test:gui:branch": "node tests/e2e/session-branch.mjs",
    "test:gui:settings": "node tests/e2e/gui-settings.mjs",
    "test:gui:theme": "node tests/e2e/gui-theme.mjs",
    "test:gui:recent": "node tests/e2e/gui-recent.mjs",
    "test:gui:focus": "node tests/e2e/gui-focus.mjs",
    "test:gui:space-pin": "node tests/e2e/gui-space-pin.mjs",
    "test:gui:formula": "node tests/e2e/gui-formula.mjs",
    "test:gui:updates": "node tests/e2e/gui-updates.mjs",
    "test:gui:widget": "node tests/e2e/widget-render.mjs",
    "test:gui:artifact": "node tests/e2e/artifact-present.mjs",
    "test:gui:subagent": "node tests/e2e/subagent-task.mjs",
    "test:gui:team": "node tests/e2e/team-create.mjs",
    "test:gui:preview": "node tests/e2e/preview-renderers.mjs",
    "test:gui:palette": "node tests/e2e/command-palette.mjs",
    "test:gui:modal-backdrop": "node tests/e2e/modal-backdrop.mjs",
    "test:gui:dark-polish": "node tests/e2e/dark-polish.mjs",
    "test:gui:library": "node tests/e2e/library.mjs",
    "test:gui:pin": "node tests/e2e/session-pin.mjs",
    "test:gui:export-markdown": "node tests/e2e/export-markdown.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "electron-updater": "^6.8.9",
    "jsonc-parser": "^3.3.1",
    "jszip": "3.10.2",
    "koffi": "3.3.1",
    "linkedom": "^0.18.13",
    "officeparser": "^8.1.0",
    "pdfjs-dist": "6.3.289",
    "turndown": "^7.2.4",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@corbe30/fortune-excel": "^2.3.3",
    "@fortune-sheet/react": "^1.0.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "26.6.2",
    "@vitejs/plugin-react": "^5.0.0",
    "docx-preview": "^0.4.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "eslint": "^9.0.0",
    "espree": "10.4.0",
    "katex": "^0.19.0",
    "monaco-editor": "^0.56.0",
    "playwright": "^1.63.0",
    "pptx-preview": "^1.0.7",
    "prettier": "^3.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-pdf": "10.5.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "xlsx": "^0.18.5"
  }
}
